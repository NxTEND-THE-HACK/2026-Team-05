#pragma once

// Copy this file to include/config.h and edit the values for each device.
// Do not commit the copied config.h because it contains the Wi-Fi password.
#define WIFI_SSID "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// Use a different ID on each of the two boards.
#define CAMERA_ID "demo-camera-1"

// Set this to 0 to use DHCP. For static IP, give each camera a unique address
// outside the router's DHCP pool. Example network: camera-1=.105, camera-2=.106.
#define CAMERA_USE_STATIC_IP 1
#define CAMERA_STATIC_IP "192.168.10.105"
#define CAMERA_GATEWAY "192.168.10.1"
#define CAMERA_SUBNET "255.255.255.0"
#define CAMERA_PRIMARY_DNS "192.168.10.1"
#define CAMERA_SECONDARY_DNS "8.8.8.8"

// 80 is convenient for the Python worker: http://<camera-ip>/stream
#define CAMERA_HTTP_PORT 80

// SVGA gives Pose + Hands more pixels to work with. If the actual LAN or
// recognition worker cannot sustain the target rate, switch to VGA or QVGA.
#define CAMERA_FRAME_SIZE FRAMESIZE_SVGA

// ESP32 camera JPEG quality uses a lower number for higher image quality.
// 8 is a high-quality starting point for SVGA streaming; 5-7 is sharper but
// heavier and may reduce the achievable FPS.
#define CAMERA_JPEG_QUALITY 8

// Cap the MJPEG stream so camera work leaves predictable CPU and Wi-Fi
// headroom for the microphone task. This is an upper bound; capture may be
// slower at larger frame sizes.
#define CAMERA_MAX_FPS 15

// Python connects to http://<camera-ip>:81/sound-events. Audio never leaves
// the device; only an event sequence and device uptime are sent.
#define AUDIO_HTTP_PORT 81

// Adaptive short-sound detector.
#define SOUND_CALIBRATION_MS 2000
#define SOUND_AMBIENT_ALPHA 0.02f
#define SOUND_TRIGGER_RATIO 3.0f
#define SOUND_TRIGGER_DEVIATIONS 6.0f
#define SOUND_RELEASE_RATIO 1.5f
#define SOUND_RELEASE_FRAMES 3
#define SOUND_COOLDOWN_MS 300
