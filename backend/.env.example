# HTTP server
PORT=8080
ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL. Empty means the in-memory store is used.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/smart_home?sslmode=disable
DATABASE_URL=

# Tuya IoT Platform
TUYA_ACCESS_ID=
TUYA_SECRET_KEY=
TUYA_REGION=us
TUYA_DEBUG=false

# Use true to verify the complete flow without sending commands to Tuya.
TUYA_DRY_RUN=true

# Smart plug device IDs
PLUG_A_ID=
PLUG_B_ID=
PLUG_C_ID=

# ESP32 infrared controller. Leave URL empty when infrared control is unused.
IR_CONTROLLER_ID=main-ir
IR_CONTROLLER_URL=
IR_CONTROLLER_API_KEY=
IR_REQUEST_TIMEOUT_MS=3000
IR_LEARNING_TIMEOUT_SECONDS=30

# Motion execution guard
ACTION_COOLDOWN_SECONDS=5
