# HTTP server
PORT=8080
ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL. Empty means the in-memory store is used.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/smart_home?sslmode=disable
DATABASE_URL=

# Tuya IoT Platform
TUYA_ACCESS_ID=
TUYA_SECRET_KEY=
TUYA_REGION=us
TUYA_DEBUG=false

# Use true to verify the complete flow without sending commands to Tuya.
TUYA_DRY_RUN=true

# Smart plug device IDs
PLUG_A_ID=
PLUG_B_ID=
PLUG_C_ID=

# Motion execution guard
ACTION_COOLDOWN_SECONDS=5
