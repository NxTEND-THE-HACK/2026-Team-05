CAMERA_ID=demo-camera-1
CAMERA_SOURCE=http://192.168.50.21/stream
# Optional. Leave empty to keep camera-only recognition.
SOUND_EVENT_SOURCE=
# Set CAMERA_WEBCAM_INDEX (for example 0) to use a USB or built-in camera.
# When it is set, the local camera is selected instead of CAMERA_SOURCE.
CAMERA_WEBCAM_INDEX=
CAMERA_WEBCAM_PROFILE=micon
CAMERA_WEBCAM_FPS=15
CAMERA_WEBCAM_JPEG_QUALITY=80
GO_API_URL=http://127.0.0.1:8080/internal/detections
LOG_LEVEL=INFO
RECONNECT_INITIAL_SECONDS=1
RECONNECT_MAX_SECONDS=30
DETECTION_SEND_RETRIES=3
DETECTION_SEND_TIMEOUT_SECONDS=3
FRAME_POLL_INTERVAL_SECONDS=0.001
CAMERA_STALE_AFTER_SECONDS=3
SOUND_STALE_AFTER_SECONDS=3
SOUND_MATCH_BEFORE_SECONDS=1
SOUND_MATCH_AFTER_SECONDS=0.25
POSE_MODEL_PATH=models/pose_landmarker_full.task
HAND_MODEL_PATH=models/hand_landmarker.task
MOTION_SAMPLES_PATH=models/motion_samples.json
TARGET_FPS=15
WINDOW_FRAMES=30
INFERENCE_STRIDE_FRAMES=3
EMA_ALPHA=0.4
LANDMARK_VISIBILITY=0.5
KNN_K=3
CONFIRMATION_COUNT=2
RECOGNITION_COOLDOWN_SECONDS=1
RECOGNITION_RESET_GAP_SECONDS=0.75
